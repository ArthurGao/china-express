# Backend API (NestJS). Local default port 3700.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3700/api/v1
# Set to "enabled" to serve the OpenAPI contract's examples with MSW instead of calling the backend (dev/test only).
NEXT_PUBLIC_API_MOCKING=
# Supabase (auth only). Local values: PUBLISHABLE_KEY from `pnpm supabase:status -o json`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WhatsApp business number for "Get a firm quote on WhatsApp", digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=
SENTRY_DSN=
