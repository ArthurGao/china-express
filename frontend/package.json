{
  "name": "china-express-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3600",
    "build": "next build",
    "start": "next start --port 3600",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript openapi/openapi.json -o src/lib/api/generated/schema.ts",
    "supabase:start": "supabase start --workdir .. -x studio,postgres-meta,imgproxy,vector,logflare,supavisor,realtime,storage-api,edge-runtime",
    "supabase:stop": "supabase stop --workdir ..",
    "lint:api": "redocly lint openapi/openapi.json --format=stylish",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev:mock": "msw init public --save=false && NEXT_PUBLIC_API_MOCKING=enabled next dev --port 3600",
    "supabase:status": "supabase status --workdir ..",
    "build:demo": "msw init public --save=false && NEXT_PUBLIC_DEMO=enabled NEXT_PUBLIC_API_MOCKING=enabled NEXT_PUBLIC_API_BASE_URL=/api/v1 next build",
    "start:demo": "next start --port 3602",
    "e2e:demo": "playwright test -c playwright.demo.config.ts"
  },
  "dependencies": {
    "@fontsource/big-shoulders-stencil-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hookform/resolvers": "6.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "jsbarcode": "3.12.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.71.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "otplib": "13.5.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.34.7"
}
